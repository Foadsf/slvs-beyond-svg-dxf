root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# SolveSpace files begin with three raw bytes (B1 B2 B3) that are not valid
# UTF-8.  Saving one as UTF-8 corrupts it.  latin-1 round-trips every byte.
[*.slvs]
charset = latin1
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
